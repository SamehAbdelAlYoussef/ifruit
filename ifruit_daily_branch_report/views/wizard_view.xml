<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_daily_branch_report_wizard" model="ir.ui.view">
        <field name="name">daily.branch.report.wizard.form</field>
        <field name="model">daily.branch.report.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير الفروع اليومي">
                <group>
                    <field name="report_date" string="تاريخ التقرير"/>
                </group>
                <footer>
                    <button name="action_print" string="طباعة التقرير" type="object" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_branch_report_wizard" model="ir.actions.act_window">
        <field name="name">تقرير الفروع اليومي</field>
        <field name="res_model">daily.branch.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_daily_branch_report"
        name="تقرير نقاط البيع"
        parent="point_of_sale.menu_point_rep"
        action="action_daily_branch_report_wizard"
        sequence="20"/>
</odoo>
