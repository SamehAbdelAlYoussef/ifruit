<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="menon_pos_session_report.ProductCardPrice" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <span class="product-price text-muted" style="font-size: 0.8rem;">
                <t t-esc="this.formattedPrice"/>
            </span>
        </xpath>
    </t>

</templates>
