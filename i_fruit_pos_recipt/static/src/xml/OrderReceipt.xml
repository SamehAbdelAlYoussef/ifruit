<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
	<t t-name="i_fruit_pos_recipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
		<xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
			<attribute name="class" add="fruit_d_none_force" separator=" "/>
		</xpath>
		<xpath expr="div[hasclass('pos-receipt')]" position="after">
			<div class="fruit-pos-receipt pos-receipt">
				<t t-if="receipt.company.logo">
	                <img class="pos-receipt-logo fruit_d_none" t-att-src="receipt.company.logo" alt="Logo"/>
	            </t>
	            <img class="pos-receipt-logo" src="/i_fruit_pos_recipt/static/src/img/i_fruti.jpeg" alt="Logo"/>

	            <table class="fruit_order_data">
					<tr>
						<td class="fruit_order_data"><t t-esc="receipt.name" /></td>
						<td class="fruit_order_tital">نوع الفاتورة</td>
					</tr>
					<tr>
						<td class="fruit_order_data">
							<t t-if="receipt.date.localestring">
			                    <t t-esc="receipt.date.localestring" />
			                </t>
			                <t t-else="">
			                    <t t-esc="receipt.date.validation_date" />
			                </t>
						</td>
						<td class="fruit_order_tital">تاريخ</td>
					</tr>
					<tr>
						<td class="fruit_order_data"><t t-esc="receipt.cashier" /></td>
						<td class="fruit_order_tital">كاشير</td>
					</tr>
				</table>
				<br/>
				<div class="fruit_order_line_table">
		            <table class="fruit_order_line_data">
						<tr>
							<th class="pos-receipt-center-align">اجمالى</th>
							<th class="pos-receipt-center-align">سعر</th>
							<th class="pos-receipt-center-align">كمية</th>
							<th class="pos-receipt-center-align">اسم المنتج</th>
							<th class="pos-receipt-center-align">عدد</th>
						</tr>
						<t t-set="line_count" t-value="0"/>
						<t t-foreach="receipt.orderlines" t-as="line" t-key="line.id">
							<t t-set="line_count" t-value="line_count + 1"/>
							<tr>
								<td class="pos-receipt-center-align">
									<span class="price_display pos-receipt-center-align">
			                        	<t t-esc="line.price_display" />
			                    	</span>
			                	</td>
								<td class="pos-receipt-center-align">
									<t t-esc="line.price_display_one" />
								</td>
								<td class="pos-receipt-center-align">
									<t t-esc="line.quantity"/>
								</td>
								<td class="pos-receipt-center-align">
									<div t-esc="line.product_name_wrapped[0]" />
			                		<WrappedProductNameLines line="line" />
			                		<t t-if="line.discount !== 0">
				                    	<div class="pos-receipt-left-padding pos-receipt-right-align">
				                        	%<t t-esc="line.discount" /> :خصم
				                    	</div>
				                	</t>
								</td>
								<td class="pos-receipt-center-align">
									<t t-esc="line_count"/>
								</td>
							</tr>
						</t>
					</table>
				</div>
				<br/>
	            <table class="fruit_order_data">
	            	<tr>
	            		<td class="fruit_order_data">
	            			<span t-esc="env.pos.format_currency(receipt.total_paid)" class="pos-receipt-center-align"/>
	            			
	            		</td>
	            		<td style="padding-left: 22px;" class="fruit_order_tital">المدفوع</td>
	            	</tr>
	            	<tr>
	            		<td class="fruit_order_data">
	            			<span t-esc="env.pos.format_currency(receipt.total_with_tax - receipt.total_paid)" class="pos-receipt-center-align"/>
	            		</td>
	            		<td class="fruit_order_tital">المتبقى</td>
	            	</tr>
	            	<tr>
	            		<td class="fruit_order_data">
	            			<span t-esc="env.pos.format_currency(receipt.total_with_tax)" class="pos-receipt-center-align"/>
	            		</td>
	            		<td class="fruit_order_tital">الاجمالى</td>
	            	</tr>
	            </table>
	            <br/>
	            <div class="fruit_recipt_footer pos-receipt-center-align">
	            	<span class="fruit_recipt_cashier"><t t-esc="receipt.cashier" /></span>
	            	<br/>
	            	<span>الأسعار شاملة ضريبة القيمة المضافة</span>
	            </div>
			</div>
		</xpath>
	</t>

</templates>