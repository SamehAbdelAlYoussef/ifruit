<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Restrict ALL POS backend menus to group_pos_manager.
        A basic POS user (group_pos_user only) sees ONLY the Dashboard.
    -->

    <!-- Orders menu -->
    <menuitem id="point_of_sale.menu_point_of_sale"
        name="Orders"
        parent="point_of_sale.menu_point_root"
        groups="point_of_sale.group_pos_manager"/>

    <!-- Reporting menu -->
    <menuitem id="point_of_sale.menu_point_rep"
        name="Reporting"
        parent="point_of_sale.menu_point_root"
        groups="point_of_sale.group_pos_manager"/>

    <!-- Products menu (child of Configuration — no inherited restriction in Odoo) -->
    <menuitem id="point_of_sale.pos_menu_products_configuration"
        name="Products"
        parent="point_of_sale.menu_point_config_product"
        groups="point_of_sale.group_pos_manager"/>
</odoo>
