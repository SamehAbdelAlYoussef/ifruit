<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Restrict POS backend navigation to managers only.
        A basic POS user (group_pos_user) sees ONLY the Dashboard
        (لوحة البيانات) so they can open their session and nothing else.
    -->

    <!-- Orders menu → managers + system admin -->
    <menuitem id="point_of_sale.menu_point_of_sale"
        name="Orders"
        parent="point_of_sale.menu_point_root"
        groups="point_of_sale.group_pos_manager,base.group_system"/>

    <!-- Reporting menu → managers + system admin -->
    <menuitem id="point_of_sale.menu_point_rep"
        name="Reporting"
        parent="point_of_sale.menu_point_root"
        groups="point_of_sale.group_pos_manager,base.group_system"/>
</odoo>
